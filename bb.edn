{:paths ["src" "resources"]
 :deps {org.babashka/cli {:mvn/version "0.12.91"}
        cheshire/cheshire {:mvn/version "6.2.0"}
        ;; clojure-mcp-light transitive deps
        parinferish/parinferish {:mvn/version "0.8.0"}
        dev.weavejester/cljfmt {:mvn/version "0.16.6"}
        ;; clojure-mcp-light — upstream delimiter repair + nREPL eval
        io.github.bhauman/clojure-mcp-light {:git/tag "v0.2.1"
                                             :git/sha "31e19702feea79e4b98c8d89d9df6e297cc740bf"}
        ;; babashka/fs — glob and filesystem utilities
        babashka/fs {:mvn/version "0.5.34"}
        ;; modex-bb — MCP server framework
        io.github.hive-agi/modex-bb {:git/tag "v0.1.14"
                                     :git/sha "7c26331a3b75903dbf646ef780082ac12492c148"}
        ;; hive-dsl — Result ADT (also used by tools.clj handlers)
        io.github.hive-agi/hive-dsl {:git/tag "v0.5.37" :git/sha "80b0563"}
        ;; hive-system — IPathQuery / IFilesystem protocols (DIP layer)
        io.github.hive-agi/hive-system {:git/tag "v0.3.22" :git/sha "be0be3a"}
        ;; hive-weave — bounded execution primitives
        io.github.hive-agi/hive-weave {:git/tag "v0.4.3" :git/sha "854b181"}}
 :tasks
 {server {:doc "Start the basic-tools MCP server (babashka)"
          :task (exec 'basic-tools-mcp.server/-main)}
  ;; modex-bb is a bb-only dep, hive-test a JVM :test dep, so both classpaths
  ;; are walked for exported clj-kondo configs.
  lint-deps {:doc "Copy dependency clj-kondo configs into .clj-kondo/imports"
             :task (do (shell "sh -c" "clj-kondo --lint \"$(bb print-deps --format classpath)\" --dependencies --copy-configs --skip-lint")
                       (shell "sh -c" "clj-kondo --lint \"$(clojure -Spath -A:test)\" --dependencies --copy-configs --skip-lint"))}
  lint {:doc "Lint src and test with the imported macro configs"
        :task (shell "clj-kondo --lint src test --fail-level error")}}}
