{:paths ["src"]
 :deps {org.babashka/cli {:mvn/version "0.12.86"}
        cheshire/cheshire {:mvn/version "6.2.0"}
        ;; clojure-mcp-light transitive deps
        parinferish/parinferish {:mvn/version "0.8.0"}
        dev.weavejester/cljfmt {:mvn/version "0.16.5"}
        ;; clojure-mcp-light — upstream delimiter repair + nREPL eval
        io.github.bhauman/clojure-mcp-light {:git/tag "v0.2.1"
                                             :git/sha "31e19702feea79e4b98c8d89d9df6e297cc740bf"}
        ;; babashka/fs — glob and filesystem utilities
        babashka/fs {:mvn/version "0.5.34"}
        ;; modex-bb — MCP server framework
        io.github.hive-agi/modex-bb {:git/tag "v0.1.4"
                                     :git/sha "1aff64fb31ff6bbf1ba7863fb947f3e835393a3e"}
        ;; hive-dsl — Result ADT (also used by tools.clj handlers)
        io.github.hive-agi/hive-dsl {:git/tag "v0.5.16" :git/sha "58a0ce1"}
        ;; hive-system — IPathQuery / IFilesystem protocols (DIP layer)
        io.github.hive-agi/hive-system {:git/tag "v0.3.6" :git/sha "a830639"}
        ;; hive-weave — bounded execution primitives
        io.github.hive-agi/hive-weave {:git/tag "v0.3.2" :git/sha "ebaa555"}}
 :tasks
 {server {:doc "Start the basic-tools MCP server (babashka)"
          :task (exec 'basic-tools-mcp.server/-main)}}}
